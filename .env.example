# Set these in Replit Secrets for production. Never put secrets in VITE_* variables.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
APP_ORIGIN=https://YOUR-PUBLISHED-APP.replit.app
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Only set after verifying the trusted proxy chain; 0 ignores forwarded IP headers.
TRUST_PROXY_HOPS=0
PORT=3001
